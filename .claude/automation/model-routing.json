{
  "version": 1,
  "default": {
    "loop": "feature.md",
    "primary_agent": "python-engineer",
    "model": "opus"
  },
  "routes": [
    {
      "id": "full-audit",
      "priority": 100,
      "keywords": [
        "auditoría completa",
